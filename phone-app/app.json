{
  "expo": {
    "name": "잘자요",
    "slug": "jaljayo-phone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bed.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/bed-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCF7ED"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jaljayo.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "같은 와이파이에 있는 침대를 찾고 연결하려면 로컬 네트워크 권한이 필요해요.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCF7ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jaljayo.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-camera",
      "expo-font",
      "expo-image",
      "expo-router",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "scheme": "jaljayo",
    "experiments": {
      "typedRoutes": true
    }
  }
}
